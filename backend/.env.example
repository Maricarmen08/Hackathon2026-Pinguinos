# Copiar a backend/.env o ejecutar npm run configure. Nunca usar root.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hackathon_pinguinos_dev
DB_USER=pinguinos_app
DB_PASSWORD=
# Generar dos secretos independientes de al menos 32 bytes; no reutilizar.
JWT_SECRET=
JWT_REFRESH_SECRET=
CORS_ORIGINS=http://localhost:5173
# Keep disabled until migration 003 and real OAuth clients are configured.
GOOGLE_AUTH_ENABLED=0
GOOGLE_CLIENT_IDS=
# No se realizan llamadas externas mientras AI_ENABLED=0.
AI_ENABLED=0
OPENAI_API_KEY=
AI_TRANSCRIPTION_MODEL=gpt-transcribe
AI_EXTRACTION_MODEL=gpt-4o-mini
# FINKI_PRIVATE_DIR: directorio privado persistente, fuera de cualquier servidor web.

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_MAX_REQUESTS_PER_DAY=20
# Gemini gratis permite unas 15 por minuto; el valor por defecto es 10.
AI_MAX_REQUESTS_PER_MINUTE=10
